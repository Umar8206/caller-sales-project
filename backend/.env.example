# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development                   # change to production in deployment
BASE_URL=https://your-domain.com       # must be HTTPS — ElevenLabs POSTs webhooks here
CORS_ORIGIN=*                          # set to your frontend domain in production (e.g. https://your-frontend.com)

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/outbound-caller

# ─── ElevenLabs ───────────────────────────────────────────────────────────────
# 1. elevenlabs.io → Conversational AI → Agents → Create Agent (write your sales script)
# 2. Agent → Phone Numbers → Add Twilio → enter Twilio SID + Auth Token → copy phone_number_id
# 3. Agent → Webhooks → add https://your-domain.com/webhooks/elevenlabs → copy signing secret
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_AGENT_ID=...
ELEVENLABS_PHONE_NUMBER_ID=...
ELEVENLABS_WEBHOOK_SECRET=...          # required in production

# ─── Worker ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5                   # parallel calls at once (start low, scale up)
CALLS_PER_HOUR=30                      # rate limit — check your Twilio plan limits
POLL_INTERVAL_MS=5000                  # how often worker checks for new leads
RETRY_DELAY_MINUTES=30                 # wait before retrying no-answer/busy
